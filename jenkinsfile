pipeline {
    agent any
 parameters {
        choice(
            name: 'browser',
            choices: ['Chrome', 'Firefox'],
            description: 'Select browser'
        )

        choice(
            name: 'Envronment',
            choices: ['QA', 'STG', 'DEV'],
            description: 'Select Envronment'
        )
    }

    stages {
        stage('Checkout Project from Git') {
            steps {
                git branch: 'main', url: 'https://github.com/patildinesh19/seleniumAllActions.git'
                echo 'Check out is done'
            }
        }
        stage('Execute smoke suite') {
            steps {
                bat "mvn clean test -PUI_Smoke_Suite -Dbrowser=${browser} -DEnvronment=${Envronment}"
                echo 'Smoke Suite executed sucessfully'
            }
	}
	stage('Execute Regression Suite') {
            steps {
                bat "mvn clean test -PUI_Regression_Suite -Dbrowser=${browser} -DEnvronment=${Envronment}"
                echo 'Regression suite executed sucessfully'
            }
	}
	stage('Execute kararte Suite') {
            steps {
                bat "mvn clean test -PKarateAPISuite -Dkarate.env=${Envronment}"
                echo 'Karate Suite executed Sucessfully'
            }

        }
    }
}
